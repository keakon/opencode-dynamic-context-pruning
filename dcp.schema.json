{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
    "title": "DCP Plugin Configuration",
    "description": "Configuration schema for the OpenCode Dynamic Context Pruning plugin",
    "type": "object",
    "allowTrailingCommas": true,
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "JSON Schema reference for IDE autocomplete"
        },
        "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable the DCP plugin"
        },
        "debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable debug logging"
        },
        "pruneNotification": {
            "type": "string",
            "enum": ["off", "minimal", "detailed"],
            "default": "detailed",
            "description": "Level of notification shown when pruning occurs"
        },
        "commands": {
            "type": "object",
            "description": "Configuration for DCP slash commands (/dcp)",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable DCP slash commands (/dcp)"
                },
                "protectedTools": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional tool names to protect from pruning via commands (e.g., /dcp sweep)"
                }
            },
            "default": {
                "enabled": true,
                "protectedTools": []
            }
        },
        "turnProtection": {
            "type": "object",
            "description": "Protect recent tool outputs from being pruned",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable turn-based protection"
                },
                "turns": {
                    "type": "number",
                    "default": 4,
                    "description": "Number of recent turns to protect from pruning"
                }
            }
        },
        "tokenBudget": {
            "type": "object",
            "description": "Token budget thresholds for context management",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable token budget-based pruning triggers"
                },
                "warnThreshold": {
                    "type": "number",
                    "default": 60000,
                    "description": "Token count threshold for warn-level nudge"
                },
                "criticalThreshold": {
                    "type": "number",
                    "default": 100000,
                    "description": "Token count threshold for critical-level nudge"
                }
            }
        },
        "protectedFilePatterns": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [],
            "description": "Glob patterns for files that should be protected from pruning (e.g., '**/*.config.ts')"
        },
        "tools": {
            "type": "object",
            "description": "Configuration for pruning tools",
            "additionalProperties": false,
            "properties": {
                "settings": {
                    "type": "object",
                    "description": "General tool settings",
                    "additionalProperties": false,
                    "properties": {
                        "nudgeEnabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable nudge reminders to prune context"
                        },
                        "nudgeFrequency": {
                            "type": "number",
                            "default": 10,
                            "description": "Frequency of nudge reminders (in turns)"
                        },
                        "protectedTools": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [
                                "task",
                                "todowrite",
                                "todoread",
                                "prune",
                                "batch",
                                "write",
                                "edit",
                                "plan_enter",
                                "plan_exit"
                            ],
                            "description": "Tool names that should be protected from automatic pruning"
                        },
                        "injectPrunableTools": {
                            "type": "string",
                            "enum": ["always", "on_demand", "on_warn"],
                            "default": "on_demand",
                            "description": "When to inject prunable-tools list: 'always' (every turn), 'on_demand' (when nudge triggers including normal, recommended), 'on_warn' (only warn/critical, best cache hit rate)"
                        }
                    }
                },
                "prune": {
                    "type": "object",
                    "description": "Configuration for the prune tool (discard or extract key findings)",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable the prune tool"
                        },
                        "showDistillation": {
                            "type": "boolean",
                            "default": false,
                            "description": "Show distillation output in the UI"
                        }
                    }
                }
            }
        },
        "strategies": {
            "type": "object",
            "description": "Automatic pruning strategies",
            "additionalProperties": false,
            "properties": {
                "deduplication": {
                    "type": "object",
                    "description": "Remove duplicate tool outputs",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable deduplication strategy"
                        },
                        "protectedTools": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [
                                "task",
                                "todowrite",
                                "todoread",
                                "prune",
                                "batch",
                                "write",
                                "edit",
                                "plan_enter",
                                "plan_exit"
                            ],
                            "description": "Tool names excluded from deduplication"
                        }
                    }
                },
                "supersedeWrites": {
                    "type": "object",
                    "description": "Replace older write/edit outputs when new ones target the same file",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": false,
                            "description": "Enable supersede writes strategy"
                        }
                    }
                },
                "purgeErrors": {
                    "type": "object",
                    "description": "Remove tool outputs that resulted in errors",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable purge errors strategy"
                        },
                        "turns": {
                            "type": "number",
                            "default": 4,
                            "description": "Number of turns after which errors are purged"
                        },
                        "protectedTools": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [
                                "task",
                                "todowrite",
                                "todoread",
                                "prune",
                                "batch",
                                "write",
                                "edit",
                                "plan_enter",
                                "plan_exit"
                            ],
                            "description": "Tool names excluded from error purging"
                        }
                    }
                },
                "purgeStaleOutputs": {
                    "type": "object",
                    "description": "Remove stale tool outputs based on age and count threshold",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true,
                            "description": "Enable purge stale outputs strategy"
                        },
                        "turns": {
                            "type": "number",
                            "default": 5,
                            "description": "Number of turns after which outputs are considered stale"
                        },
                        "minPrunableCount": {
                            "type": "number",
                            "default": 10,
                            "description": "Minimum number of prunable tools before triggering this strategy"
                        },
                        "preserveRecent": {
                            "type": "number",
                            "default": 3,
                            "description": "Number of recent outputs per tool type to preserve"
                        },
                        "protectedTools": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "default": [],
                            "description": "Additional tool names to protect from stale output purging"
                        }
                    }
                }
            }
        },
        "smallModelAdvisor": {
            "enabled": true,
            "fallbackModels": ["openai/gpt-4o-mini", "anthropic/claude-3-haiku"],
            "type": "object",
            "description": "Small model advisor for intelligent pruning suggestions (uses OpenCode's small_model via temporary session)",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable the small model advisor"
                },
                "minPrunableCount": {
                    "type": "number",
                    "default": 5,
                    "description": "Minimum number of prunable tools before triggering advisor"
                },
                "tokenThreshold": {
                    "type": "number",
                    "default": 40000,
                    "description": "Token threshold to trigger advisor analysis (should be lower than tokenBudget.warnThreshold)"
                },
                "timeout": {
                    "type": "number",
                    "default": 10000,
                    "description": "Maximum latency in milliseconds before aborting advisor request"
                },
                "contentPreviewLength": {
                    "type": "number",
                    "default": 200,
                    "description": "Length of content preview sent to advisor for each tool output"
                },
                "maxToolsInPrompt": {
                    "type": "number",
                    "default": 30,
                    "description": "Maximum number of tools to include in advisor prompt"
                },
                "sendContentPreview": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to send content preview to advisor"
                },
                "fallbackModels": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Fallback model list for retry on failure (model IDs for OpenCode small_model override)"
                },
                "suppressNudge": {
                    "type": "boolean",
                    "default": true,
                    "description": "Suppress normal/warn nudge when advisor is active"
                },
                "debug": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable debug logging for advisor"
                }
            }
        }
    }
}
